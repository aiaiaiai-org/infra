# © 2026 aiaiaiai · aiaiaiai.org
#
# The aiaiaiai.org edge on edge-prod-2. Only prism-* and other aiaiaiai services are routed here;
# the 0x1 product has its own edge (deploy/edge) on edge-prod-1.

{$PRISM_API_DOMAIN:api.aiaiaiai.org} {
	encode zstd gzip

	@prism_hub_root path /prism-hub
	redir @prism_hub_root /prism-hub/ 308

	handle_path /prism-hub/* {
		reverse_proxy prism-hub:1927 {
			health_uri /healthz
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	@hua_bot_root path /hua-bot
	redir @hua_bot_root /hua-bot/ 308

	# Canonical bot prefix; the application keeps /api/v1/delivery.
	handle_path /hua-bot/* {
		reverse_proxy h-ua-bot:1927 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	# Legacy routes remain during rollout.
	# Prism Hub delivers Telegram messages here with its shared delivery secret.
	# Keep the incoming path intact: h-ua-bot serves POST /api/v1/delivery.
	@hua_delivery path /api/v1/delivery
	handle @hua_delivery {
		reverse_proxy h-ua-bot:1927 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	# Operator liveness, separate from the Hub API prefix.
	handle_path /h-ua-bot/* {
		reverse_proxy h-ua-bot:1927 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	# Nothing else is served on this host yet.
	handle {
		respond 404
	}

	log {
		output stdout
		format json
	}
}
