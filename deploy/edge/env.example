EDGE_TARGET=edge-prod-1
MARKET_DOMAIN=0xda-market.nilx.one
NILX_WEB_DOMAIN=nilx.one
NILX_BOND_DOMAIN=*.nilx.one
NILX_BOND_TRANSPORT=bond_transport_cloudflare
MIND_WEB_DOMAIN=mind.aiaiaiai.org
EDGE_NETWORK=nilx-edge
CADDY_IMAGE=zero-x-infra-caddy-cloudflare:local

# Scoped Cloudflare API token used only for ACME DNS-01.
# Required permissions for nilx.one: Zone:Read + DNS:Edit.
CF_API_TOKEN=

# Existing TLS state is adopted during the first cutover.
# The physical Docker volume names are retained to avoid certificate re-issuance.
CADDY_DATA_VOLUME=zero-x-da-market-caddy-data
CADDY_CONFIG_VOLUME=zero-x-da-market-caddy-config
LEGACY_CADDY_CONTAINER=mind-web-prod-1-caddy

# Activation is invalid unless public HTTPS verification is enabled.
VERIFY_PUBLIC_HTTPS=1
