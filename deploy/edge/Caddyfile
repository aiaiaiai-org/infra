(bond_transport) {
	encode zstd gzip
}

(bond_transport_cloudflare) {
	encode zstd gzip
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}
}

{$MARKET_DOMAIN:0xda-market.nilx.one} {
	encode zstd gzip

	handle_path /bot-test/* {
		reverse_proxy market-bot-development:10000 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	handle_path /bot/* {
		reverse_proxy market-bot-production:10000 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	# Browser sessions, checkout and issuer orders share the isolated
	# Market development API until a separately reviewed production rollout.
	# Keep all other APIs, payment/operator routes and bots on their existing paths.
	@market_browser_development path /nilx-browser/handoffs /nilx-browser/exchange /nilx-browser/session /v1/webapp/bootstrap /nilx-browser/offers /nilx-browser/orders /nilx-browser/orders/* /issuer/v1/orders /issuer/v1/orders/*
	handle @market_browser_development {
		reverse_proxy market-api-development:10000 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	# Point pages and immutable Web assets share the deployed 0x1 browser host.
	# API, handoff/session, health and bot routes remain on their current services.
	@market_web path / /assets/* /map/* /avatars/* /models/* /voices/* /monuments/* /market-api/* /market-license.txt /золоті /золоті/ /zoloti-vorota /zoloti-vorota/ /batkivshchyna /peizazhna-aleia /cosmopolite /gorodok-gallery /smart-plaza-polytech /raion /mandarin-plaza /respublika-park /lavina-mall /river-mall /retroville /tsum /skymall /dream-berry /dream-yellow /gulliver /osokorky /pozniaky /troieshchyna-centre /livoberezhna /petra-zaporozhtsia
	handle @market_web {
		reverse_proxy nilxone-web:1927 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	handle {
		reverse_proxy market-api-production:10000 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	log {
		output stdout
		format json
	}
}

{$NILX_BOND_DOMAIN:*.nilx.one} {
	import {$NILX_BOND_TRANSPORT:bond_transport}

	handle {
		reverse_proxy nilxone-web:1927 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	log {
		output stdout
		format json
	}
}

{$NILX_WEB_DOMAIN:nilx.one} {
	encode zstd gzip

	@telegram_root path /telegram
	redir @telegram_root /telegram/ 308

	@discord_root path /discord
	redir @discord_root /discord/ 308

	handle_path /telegram/* {
		reverse_proxy nilxone-telegram:1927 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	handle_path /discord/* {
		reverse_proxy nilxone-discord:1927 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	handle /api/v1/* {
		reverse_proxy nilxone-identity:1927 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	handle {
		reverse_proxy nilxone-web:1927 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	log {
		output stdout
		format json
	}
}
