(bond_transport) {
	encode zstd gzip
}

(bond_transport_cloudflare) {
	encode zstd gzip
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}
}

{$MARKET_DOMAIN:0xda-market.nilx.one} {
	encode zstd gzip

	handle_path /bot-test/* {
		reverse_proxy market-bot-development:10000 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	handle_path /bot/* {
		reverse_proxy market-bot-production:10000 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	handle {
		reverse_proxy market-api-production:10000 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	log {
		output stdout
		format json
	}
}

{$NILX_BOND_DOMAIN:*.nilx.one} {
	import {$NILX_BOND_TRANSPORT:bond_transport}

	handle {
		reverse_proxy ox1-web:8080 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	log {
		output stdout
		format json
	}
}

{$NILX_WEB_DOMAIN:nilx.one} {
	encode zstd gzip

	@telegram_root path /telegram
	redir @telegram_root /telegram/ 308

	@discord_root path /discord
	redir @discord_root /discord/ 308

	handle_path /telegram/* {
		reverse_proxy ox1-telegram:8080 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	handle_path /discord/* {
		reverse_proxy ox1-discord:8080 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	handle {
		reverse_proxy ox1-web:8080 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	log {
		output stdout
		format json
	}
}

