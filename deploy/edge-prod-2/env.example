EDGE_TARGET=edge-prod-2
PRISM_HUB_DOMAIN=hub.aiaiaiai.org
EDGE_TRANSPORT=transport_cloudflare
CADDY_IMAGE=aiaiaiai-infra-caddy-cloudflare:local
RELEASE_SHA=local

# Space-separated loopback health URLs, derived from contracts/edges/edge-prod-2.yaml.
UPSTREAM_HEALTH_URLS="http://127.0.0.1:1927/healthz"

# Scoped Cloudflare API token used only for ACME DNS-01.
# Required permissions for aiaiaiai.org: Zone:Read + DNS:Edit.
CF_API_TOKEN=
