# © 2026 aiaiaiai · aiaiaiai.org
#
# edge-prod-2 serves aiaiaiai.org only. Caddy runs in the host network
# namespace; every upstream is a loopback-bound host-native workload.

{
	# The admin API would listen on host loopback, next to the workloads.
	# Activation recreates the container instead of reloading it.
	admin off
}

(transport) {
	encode zstd gzip
}

(transport_cloudflare) {
	encode zstd gzip
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}
}

{$PRISM_HUB_DOMAIN:hub.aiaiaiai.org} {
	import {$EDGE_TRANSPORT:transport}

	handle {
		reverse_proxy 127.0.0.1:1927 {
			health_uri /healthz
			# Hub forces SSL; the probe must look like the TLS-terminated
			# requests it proxies or it is answered with a redirect.
			health_headers {
				X-Forwarded-Proto https
			}
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	log {
		output stdout
		format json
	}
}
