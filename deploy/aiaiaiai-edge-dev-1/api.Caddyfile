# © 2026 aiaiaiai · aiaiaiai.org

# api.aiaiaiai.org on edge-dev-1's existing public Caddy, for prism-hub, prism-hubot, h-ua-bot and 4x-errors. The routes
# are the ones the old edge served (deploy/edge-aiaiaiai/Caddyfile), on the same private Docker network
# as this ingress. Other prefixes are added when their workloads move.
api.aiaiaiai.org {
	encode zstd gzip

	@prism_hub_root path /prism-hub
	redir @prism_hub_root /prism-hub/ 308

	handle_path /prism-hub/* {
		reverse_proxy prism-hub:1927 {
			health_uri /healthz
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	@prism_hubot_root path /prism-hubot
	redir @prism_hubot_root /prism-hubot/ 308

	# Telegram posts to /prism-hubot/telegram/webhook; the bot serves /telegram/webhook.
	handle_path /prism-hubot/* {
		reverse_proxy prism-hubot:1927 {
			health_uri /healthz
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	@hua_bot_root path /hua-bot
	redir @hua_bot_root /hua-bot/ 308

	# Canonical bot prefix; the bot keeps /api/v1/delivery, which Prism Hub calls through this route.
	handle_path /hua-bot/* {
		reverse_proxy h-ua-bot:1927 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
			lb_try_duration 5s
		}
	}

	@errors_root path /4x-errors
	redir @errors_root /4x-errors/ 308

	# The collector owns /v1/browser/events, /v1/events and /ready.
	# Keep Origin intact for its CORS and project allowlist checks.
	handle_path /4x-errors/* {
		reverse_proxy 4x-errors:1927 {
			health_uri /ready
			health_interval 30s
			health_timeout 5s
		}
	}

	handle {
		respond "not found" 404
	}
}
